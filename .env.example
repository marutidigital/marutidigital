# ==========================================================
# Maruti Digital — Environment Variables
# Copy this file to .env.local and fill in your actual values
# ==========================================================

# ── Supabase ──────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Stripe ────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
# Webhook secret — from: Stripe Dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── App URL ───────────────────────────────────────────────
# Used for Stripe success/cancel redirect URLs
NEXT_PUBLIC_APP_URL=https://marutidigital.in

# ── Optional: For local development ───────────────────────
# Use Stripe test mode keys locally:
# STRIPE_SECRET_KEY=sk_test_your_test_key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key
# NEXT_PUBLIC_APP_URL=http://localhost:3000
